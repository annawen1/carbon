{
  "name": "carbon-web-components-custom-registration-example",
  "version": "0.1.0",
  "private": true,
  "description": "Custom registration examples for @carbon/web-components (default, defineCustomElement, custom name, scoped registry, prefixed build).",
  "license": "Apache-2",
  "main": "default.html",
