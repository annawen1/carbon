    "clean": "rimraf node_modules dist .cache vendor"
  },
  "dependencies": {
    "@carbon/styles": "^1.108.0",
    "@carbon/web-components": "latest",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "vite": "^7.1.2"
  }
}
