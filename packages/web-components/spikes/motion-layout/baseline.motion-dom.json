{
  "_meta": {
    "purpose": "Conformance reference for the hand-written FLIP engine that replaces motion-dom. Captured from the Phase 0 spike while it was still driving Motion's projection engine via LayoutAnimationBuilder. A replacement engine should reproduce these trajectories within tolerance.",
    "capturedFrom": "packages/web-components/spikes/motion-layout/spike.js",
    "engine": "motion-dom@12.42.0 LayoutAnimationBuilder",
    "surface": "expand (@carbon/motion)",
    "transition": { "durationMs": 240, "ease": [0.2, 0, 0.38, 0.9] },
    "method": "5 repetitions per case per phase; per-frame computed transform of the tracked element that moved most, resampled at normalised progress and reduced with a median across repetitions.",
    "fields": {
      "at": "normalised progress through the animation, 0 to 1",
      "sx": "matrix scaleX",
      "sy": "matrix scaleY",
      "tx": "matrix translateX in px",
      "ty": "matrix translateY in px",
      "animations": "number of animations the update produced"
    },
    "tolerance": {
      "durationMs": 25,
      "scale": 0.05,
      "translatePx": 12,
      "note": "Translate values are viewport-relative and depend on window size, so re-capture the baseline if the harness viewport changes. Scale values and the shape of the easing curve are the meaningful invariants."
    }
  },

